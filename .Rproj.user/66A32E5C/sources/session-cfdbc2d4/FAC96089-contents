<script>
(function () {
  'use strict';
  const start = () => {
    const root = document.getElementById('sia-quiz');
    if (!root) return;
    const cards = Array.from(root.querySelectorAll('.sia-question'));
    const config = window.SIAQuiz || {pass:16,code:'ADAP1025'};
    const fill = root.querySelector('#sia-fill');
    const score = root.querySelector('#sia-score');
    const checkedText = root.querySelector('#sia-checked');
    const message = root.querySelector('#sia-message');
    const panel = root.querySelector('#sia-code-panel');
    const success = root.querySelector('#sia-success-code');
    const copyButton = root.querySelector('#sia-copy-code');
    const copyMessage = root.querySelector('#sia-copy-message');
    const progress = root.querySelector('[role="progressbar"]');
    function update() {
      const checked = cards.filter(c => c.dataset.checked === 'true').length;
      const correct = cards.filter(c => c.dataset.checked === 'true' && c.dataset.correct === 'true').length;
      const total = cards.length;
      const percentage = total ? 100 * correct / total : 0;
      fill.style.width = percentage + '%';
      progress.setAttribute('aria-valuenow', String(Math.round(percentage)));
      score.textContent = `${correct} / ${total} correct`;
      checkedText.textContent = `${checked} of ${total} checked`;
      const passed = total > 0 && correct >= config.pass;
      panel.style.display = passed ? 'block' : 'none';
      success.textContent = passed ? config.code : '';
      if (passed) message.textContent = 'Mastery standard achieved. Your success code is shown below.';
      else if (checked < total) message.textContent = `You have ${correct} correct answers. Earn ${config.pass - correct} more correct answer(s) to unlock the code. ${total - checked} question(s) have not yet been checked.`;
      else message.textContent = `You have ${correct} correct answers. Review and retry to achieve ${config.pass}.`;
    }
    function clearCard(card, resetRadio = false) {
      card.dataset.checked = 'false';
      card.dataset.correct = 'false';
      card.querySelectorAll('.sia-choice').forEach(label => label.classList.remove('sia-correct','sia-incorrect'));
      if (resetRadio) card.querySelectorAll('input[type="radio"]').forEach(input => { input.checked = false; });
      const feedback = card.querySelector('.sia-feedback');
      feedback.className = 'sia-feedback';
      feedback.textContent = '';
      card.querySelector('.sia-status').textContent = 'Not checked';
    }
    cards.forEach(card => {
      const radios = Array.from(card.querySelectorAll('input[type="radio"]'));
      const feedback = card.querySelector('.sia-feedback');
      const status = card.querySelector('.sia-status');
      radios.forEach(radio => radio.addEventListener('change', () => { clearCard(card); update(); }));
      card.querySelector('.sia-check').addEventListener('click', () => {
        const selected = radios.find(input => input.checked);
        if (!selected) { status.textContent = 'Choose an answer first'; return; }
        const correct = selected.value === card.dataset.answer;
        card.dataset.checked = 'true';
        card.dataset.correct = String(correct);
        card.querySelectorAll('.sia-choice').forEach(label => label.classList.remove('sia-correct','sia-incorrect'));
        selected.closest('.sia-choice').classList.add(correct ? 'sia-correct' : 'sia-incorrect');
        if (!correct) {
          const right = radios.find(radio => radio.value === card.dataset.answer);
          if (right) right.closest('.sia-choice').classList.add('sia-correct');
        }
        feedback.className = 'sia-feedback ' + (correct ? 'sia-good' : 'sia-bad');
        feedback.textContent = (correct ? 'Well done. ' : 'Review and try again. ') + feedback.dataset.explanation;
        status.textContent = correct ? 'Correct' : 'Review and retry';
        update();
      });
    });
    copyButton.addEventListener('click', async () => {
      if (panel.style.display !== 'block' || !success.textContent) return;
      const value = success.textContent.trim();
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(value);
        } else {
          const field = document.createElement('textarea');
          field.value = value;
          field.style.position = 'fixed';
          field.style.opacity = '0';
          document.body.appendChild(field);
          field.select();
          const copied = document.execCommand('copy');
          field.remove();
          if (!copied) throw new Error('Clipboard unavailable');
        }
        copyMessage.textContent = 'Copied to clipboard: ' + value;
      } catch (err) {
        copyMessage.textContent = 'Select the code above and copy it manually.';
      }
    });
    root.querySelector('#sia-reset').addEventListener('click', () => {
      cards.forEach(card => clearCard(card, true));
      copyMessage.textContent = '';
      update();
      root.scrollIntoView({behavior:'smooth',block:'start'});
    });
    update();
  };
