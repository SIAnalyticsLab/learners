<script>
(function () {
  'use strict';
  function ready() {
    const cards = Array.from(document.querySelectorAll('.quiz-card'));
    const config = window.SIA_QUIZ_CONFIG || {pass:16, code:'ADAP1025'};
    const fill = document.getElementById('score-fill');
    const scoreCount = document.getElementById('score-count');
    const checkedCount = document.getElementById('checked-count');
    const message = document.getElementById('result-message');
    const panel = document.getElementById('success-panel');
    const code = document.getElementById('success-code');
    function update() {
      const correct = cards.filter(c => c.dataset.checked === 'true' && c.dataset.correct === 'true').length;
      const checked = cards.filter(c => c.dataset.checked === 'true').length;
      const total = cards.length;
      scoreCount.textContent = `${correct} / ${total} correct`;
      checkedCount.textContent = `${checked} of ${total} checked`;
      fill.style.width = `${total ? 100 * correct / total : 0}%`;
      const passed = checked === total && correct >= config.pass;
      panel.style.display = passed ? 'block' : 'none';
      code.textContent = passed ? config.code : '';
      if (passed) message.textContent = 'Mastery standard achieved. Your success code is below.';
      else if (checked < total) message.textContent = `Check ${total - checked} remaining question(s). At least ${config.pass} correct answers are required.`;
      else message.textContent = `You have ${correct} correct answers. Review and retry to reach ${config.pass}.`;
    }
    cards.forEach((card) => {
      const inputs = Array.from(card.querySelectorAll('input[type="radio"]'));
      const feedback = card.querySelector('.feedback');
      const status = card.querySelector('.status');
      function clear() {
        card.dataset.checked = 'false';card.dataset.correct = 'false';
        card.querySelectorAll('.answer').forEach(a => a.classList.remove('good','bad'));
        feedback.className = 'feedback';feedback.textContent = '';
        status.textContent = 'Not checked';update();
      }
      inputs.forEach(input => input.addEventListener('change', clear));
      card.querySelector('.check').addEventListener('click', () => {
        const selected = inputs.find(input => input.checked);
        if (!selected) { status.textContent = 'Select an answer first'; return; }
        const ok = selected.value === card.dataset.answer;
        card.dataset.checked = 'true';card.dataset.correct = String(ok);
        card.querySelectorAll('.answer').forEach(a => a.classList.remove('good','bad'));
        selected.closest('.answer').classList.add(ok ? 'good' : 'bad');
        const right = inputs.find(input => input.value === card.dataset.answer);
        if (!ok && right) right.closest('.answer').classList.add('good');
        feedback.className = 'feedback ' + (ok ? 'good' : 'bad');
        feedback.textContent = (ok ? 'Well done. ' : 'Review this concept. ') + feedback.dataset.explanation;
        status.textContent = ok ? 'Correct' : 'Review and retry';
        update();
      });
    });
    document.getElementById('reset-all').addEventListener('click', () => {
      cards.forEach(card => {
        card.querySelectorAll('input[type="radio"]').forEach(el => el.checked = false);
        card.dataset.checked = 'false';card.dataset.correct = 'false';
        card.querySelectorAll('.answer').forEach(a => a.classList.remove('good','bad'));
        const feedback = card.querySelector('.feedback');feedback.className='feedback';feedback.textContent='';
        card.querySelector('.status').textContent = 'Not checked';
      });
      update();window.scrollTo({top:0, behavior:'smooth'});
    });
    update();
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', ready);
  else ready();
})();
</script>
