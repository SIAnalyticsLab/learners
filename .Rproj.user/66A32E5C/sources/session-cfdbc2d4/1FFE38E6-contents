```{r}
#| label: quiz-data
#| include: false
questions <- list(
  list(topic="Comments", stem="Which symbol begins a single-line comment in Python?", options=c("#", "//", "--", "%"), answer="A", explanation="Python ignores the text following # on that line."),
  list(topic="Comments", stem="What happens when Python runs <code>2 + 2  # addition</code>?", options=c("It displays 4", "It raises a NameError", "It displays the word addition", "It ignores the whole line"), answer="A", explanation="The arithmetic runs normally. Only the text after # is ignored."),
  list(topic="Arithmetic", stem="What does <code>10 % 3</code> return?", options=c("3", "1", "0", "3.33"), answer="B", explanation="The modulo operator (%) returns the remainder after division; dividing 10 by 3 leaves 1."),
  list(topic="Arithmetic", stem="What does <code>10 // 3</code> return?", options=c("3.33", "4", "3", "1"), answer="C", explanation="The // operator performs floor division, giving 3 here."),
  list(topic="Arithmetic", stem="What is the result of <code>2 + 2 * 2</code>?", options=c("8", "6", "12", "4"), answer="B", explanation="Multiplication occurs before addition: 2 + (2 × 2) = 6."),
  list(topic="Arithmetic", stem="Which expression evaluates to <code>10</code>?", options=c("2 + 2 * 3", "6 + 2 ** 2", "2 ** 3 + 3", "10 % 3"), answer="B", explanation="Exponentiation occurs first: 2 ** 2 = 4, then 6 + 4 = 10."),
  list(topic="Math library", stem="Which code finds the square root of 81 using the math library?", options=c("math.sqrt(81) after import math", "math.square(81) after import math", "sqrt.math(81) after import math", "math.log(81) after import math"), answer="A", explanation="Import math, then call math.sqrt(81) to obtain 9.0."),
  list(topic="Math library", stem="In <code>random.randint(1, 10)</code>, what are <code>1</code> and <code>10</code>?", options=c("Libraries", "Variables", "Arguments", "Modules"), answer="C", explanation="The two numbers are arguments passed to the randint function."),
  list(topic="Code readability", stem="What is wrong with a leading space before <code>math.sqrt(100)</code> at the top level, when no block is open?", options=c("It changes the square root", "It may raise IndentationError", "It changes 100 to text", "It imports math automatically"), answer="B", explanation="Unexpected indentation outside a code block can raise IndentationError."),
  list(topic="Code readability", stem="Which line follows the spacing convention taught in the lesson?", options=c("x=5+3*2", "x =5+3*2", "x = 5 + 3 * 2", "x= 5+ 3*2"), answer="C", explanation="Spaces around assignment and arithmetic operators improve readability."),
  list(topic="Variables and types", stem="After <code>my_var = 2 + 2</code>, what is the value of <code>my_var</code>?", options=c("2", "4", "\"2 + 2\"", "None"), answer="B", explanation="The expression is evaluated before its result, 4, is stored in my_var."),
  list(topic="Variables and types", stem="Which built-in function can identify whether <code>height = 1.4</code> is a float?", options=c("print()", "input()", "len()", "type()"), answer="D", explanation="type(height) returns the type of its value, which is float in this case."),
  list(topic="Variables and types", stem="What is displayed by <code>first_name = \"Joanna\"</code> followed by <code>first_name = \"Luigi\"</code> and <code>print(first_name)</code>?", options=c("Joanna", "Luigi", "Joanna Luigi", "NameError"), answer="B", explanation="The second assignment replaces the prior value; print displays Luigi."),
  list(topic="Variables and types", stem="What does <code>\"Joanna\" + \" \" + \"Luigi\"</code> produce?", options=c("JoannaLuigi", "Joanna Luigi", "A TypeError", "Joanna + Luigi"), answer="B", explanation="The + operator concatenates the strings, and the middle string adds a space."),
  list(topic="Input", stem="What kind of value does <code>input()</code> normally return?", options=c("An integer", "A float", "A string", "A Boolean"), answer="C", explanation="The input() function returns entered text as a string, even if the user types digits."),
  list(topic="Input", stem="Which code asks for a name and then prints a greeting using that name?", options=c("name = input(\"Name? \"); print(\"Hello,\", name)", "name = print(\"Name? \"); input(name)", "input = name(\"Name? \"); print(name)", "name = type(\"Name? \"); print(name)"), answer="A", explanation="input() captures the response; print() can then use the stored variable."),
  list(topic="Errors", stem="If you define <code>my_number = 48</code> and then evaluate <code>My_number + 2</code>, what happens?", options=c("It returns 50", "It returns 48", "It raises NameError", "It returns 482"), answer="C", explanation="Python is case-sensitive; My_number is different from my_number and has not been defined."),
  list(topic="Errors", stem="Given <code>my_1st_name = \"Kene\"</code>, why might <code>print(my_Ist_name)</code> fail?", options=c("The string must use single quotes", "The variable names differ: 1 versus I", "Python cannot print strings", "Underscores are forbidden"), answer="B", explanation="The reference uses digit 1 while the print statement uses uppercase I, so the latter name is undefined."),
  list(topic="Naming", stem="Which of these is a valid Python variable name?", options=c("1st_name", "full-name", "current@job", "age_in_years"), answer="D", explanation="Names can contain letters, digits and underscores but may not begin with a digit or contain hyphens or @."),
  list(topic="Naming", stem="Which naming style does the lesson recommend for descriptive, multiword variables?", options=c("snake_case", "kebab-case", "spaces between words", "names beginning with numbers"), answer="A", explanation="The lesson recommends lowercase snake_case with underscores between words.")
)
stopifnot(length(questions) == 20L)
pass_mark <- 16L
# The public success code is a learning acknowledgment, not tamper-proof certification.
success_code <- "ADAP1025"

escape_html <- function(x) {
  x <- gsub("&", "&amp;", x, fixed = TRUE)
  x <- gsub("<", "&lt;", x, fixed = TRUE)
  x <- gsub(">", "&gt;", x, fixed = TRUE)
  x <- gsub('"', "&quot;", x, fixed = TRUE)
  x
}
