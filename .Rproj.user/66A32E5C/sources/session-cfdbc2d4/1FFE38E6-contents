#| label: quiz-cards
#| echo: false
#| results: asis
#| output: asis

last_topic <- ""
for (i in seq_along(questions)) {
  q <- questions[[i]]
  if (!identical(q$topic, last_topic)) {
    cat(sprintf('<section class="group-title"><h2>%s</h2></section>\n', escape_html(q$topic)))
    last_topic <- q$topic
  }
  cat(sprintf('<article class="quiz-card" id="question-%d" data-answer="%s" data-checked="false">\n', i, q$answer))
  cat(sprintf('<div class="quiz-top"><span class="qnumber">QUESTION %02d</span><span class="qtopic">%s</span></div>\n', i, escape_html(q$topic)))
  # Stems intentionally include only trusted, author-created <code> tags.
  cat(sprintf('<div class="question">%s</div>\n', q$stem))
  cat('<div class="answers">\n')
  for (j in seq_along(q$options)) {
    letter <- LETTERS[j]
    cat(sprintf('<label class="answer"><input type="radio" name="q%d" value="%s"><span class="letter">%s</span><span>%s</span></label>\n', i, letter, letter, escape_html(q$options[j])))
  }
  cat('</div><div class="actions"><button type="button" class="check">Check answer</button><span class="status" aria-live="polite">Not checked</span></div>\n')
  cat(sprintf('<div class="feedback" data-explanation="%s" aria-live="polite"></div>\n', escape_html(q$explanation)))
  cat('</article>\n')
}
